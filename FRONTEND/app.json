{
  "expo": {
    "name": "CashCompass",
    "slug": "cashcompass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cashcompass",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F6FC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7654E8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
