{
  "name": "cashcompass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline AI finance assistant for Android",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "export:schema": "tsx scripts/export-schema.ts",
    "export:plugin": "tsx scripts/export-plugin.ts",
    "cap:sync": "npm run build && cap sync android",
    "golden": "python3 ml/reference/generate_golden.py"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native-web": "^0.19.13",
    "react-router-dom": "6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "6.1.2",
    "@testing-library/react": "16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "2.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "^5.5.4",
    "vite": "5.4.8",
    "vitest": "^2.1.2"
  },
  "overrides": {
    "tslib": "2.8.1"
  }
}
