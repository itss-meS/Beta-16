# GEMINI_API_KEY: Optional server-side key (unused in 100% offline mode).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: 256-bit hex secret used to sign HS256 authentication tokens on the server.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_CRYPTOGRAPHIC_HEX_SECRET"
